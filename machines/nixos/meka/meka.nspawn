# systemd-nspawn container configuration for meka.
#
# The machine name is taken from this file's name ("meka"). Install on the
# host as /etc/systemd/nspawn/meka.nspawn, then start it with either:
#   machinectl start meka
#   systemctl start systemd-nspawn@meka.service
#
# Rootfs: the self-contained tarball built from the dedicated NixOS config.
#   nix build .#nixosConfigurations.meka.config.system.build.tarball
# Extract once (and re-extract whenever the tarball changes):
#   mkdir -p /var/lib/machines/meka /var/lib/meka
#   tar -xJf result/tarball/meka-rootfs.tar.xz -C /var/lib/machines/meka
#   install -m 600 /path/to/token /run/secrets/meka-token
#
# Networking: VirtualEthernet=yes creates host0 (guest) <-> ve-meka (host).
# The host must run systemd-networkd, whose stock 80-container-ve.network
# assigns ve-meka an address and runs DHCP + IP masquerade for the guest. The
# guest's stock 80-container-host0.network brings host0 up via DHCP. Port=
# then DNATs a host port onto the guest's nginx.

[Exec]
# Boot systemd inside the container (runs /sbin/init from the rootfs).
Boot=yes

# Extracted rootfs.
Directory=/var/lib/machines/meka

# Outer security boundary: container root must NOT map to host UID 0.
# "pick" allocates an unprivileged UID range for the container's namespace.
PrivateUsers=pick

# Report READY=1 when the guest's init signals readiness.
NotifyReady=yes

# Forward a clean shutdown signal to the inner systemd.
KillSignal=SIGRTMIN+3

[Files]
# Read-only bearer-token bind. "rootidmap" maps container UID 0 to the host
# owner of the source file, so a 0600 token stays readable under
# PrivateUsers=pick (a plain bind would map host root to "nobody").
BindReadOnly=/run/secrets/meka-token:/etc/meka/token:rootidmap

# Writable persistent data directory (survives rootfs re-extraction).
Bind=/var/lib/meka:/var/lib/meka:rootidmap

[Network]
# Create a veth pair: host0 (guest) <-> ve-meka (host).
VirtualEthernet=yes

# Expose the guest's nginx (port 80) on the host's port 8080:
#   http://<host>:8080  ->  nginx in the guest (web UI + /api reverse proxy)
# Requires the private veth above plus a running systemd-networkd on the host
# (80-container-ve.network assigns ve-meka and serves DHCP to the guest).
Port=tcp:8080:80
