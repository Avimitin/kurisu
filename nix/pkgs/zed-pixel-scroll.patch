+pub(super) fn append_overscan_row(term: &Term<ZedListener>, content: &mut Content) {
+    if content.display_offset == 0 {
+        return;
+    }
+
+    let screen_lines = i32::try_from(term.screen_lines()).unwrap_or(i32::MAX);
+    let display_offset = i32::try_from(content.display_offset).unwrap_or(i32::MAX);
+    let line = Line(screen_lines.saturating_sub(display_offset));
+    content.cells.reserve(term.columns());
+    for column in 0..term.columns() {
+        let point = AlacPoint::new(line, Column(column));
+        content.cells.push(IndexedCell {
+            point: terminal_point_from_alacritty(point),
+            cell: terminal_cell_from_alacritty(&term.grid()[point]),
+        });
+    }
+}
