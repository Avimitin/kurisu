+#[derive(Clone, Copy, Debug)]
+struct PixelScrollState {
+    position: f32,
+    display_offset: usize,
+}
+
+impl PixelScrollState {
+    fn new(display_offset: usize, line_height: Pixels) -> Self {
+        Self {
+            position: display_offset as f32 * f32::from(line_height),
+            display_offset,
+        }
+    }
+
+    fn scroll(&mut self, delta: Pixels, line_height: Pixels, maximum_display_offset: usize) -> i32 {
+        let line_height = f32::from(line_height);
+        if line_height <= 0.0 {
+            return 0;
+        }
+
+        let maximum_position = maximum_display_offset as f32 * line_height;
+        self.position = (self.position + f32::from(delta)).clamp(0.0, maximum_position);
+
+        // Keeping the overscan row below the regular viewport lets existing
+        // cell indexing remain unchanged while the grid is translated upward.
+        let new_display_offset =
+            ((self.position / line_height).ceil() as usize).min(maximum_display_offset);
+        let line_delta = new_display_offset as i64 - self.display_offset as i64;
+        self.display_offset = new_display_offset;
+        line_delta.clamp(i32::MIN as i64, i32::MAX as i64) as i32
+    }
+
+    fn render_offset(&self, line_height: Pixels) -> Pixels {
+        px(self.position - self.display_offset as f32 * f32::from(line_height))
+    }
+
+    fn reconcile(
+        &mut self,
+        display_offset: usize,
+        line_height: Pixels,
+        maximum_display_offset: usize,
+    ) {
+        let line_height = f32::from(line_height);
+        if line_height <= 0.0 {
+            self.position = 0.0;
+            self.display_offset = display_offset;
+            return;
+        }
+
+        let render_offset = f32::from(self.render_offset(px(line_height)));
+        self.display_offset = display_offset;
+        self.position = (display_offset as f32 * line_height + render_offset)
+            .clamp(0.0, maximum_display_offset as f32 * line_height);
+    }
+}
